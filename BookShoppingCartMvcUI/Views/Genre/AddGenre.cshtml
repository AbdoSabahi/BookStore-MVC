@model Genre
@{
    ViewData["Title"] = "Add Genre";
}

<div class="container py-4">
    <div class="row justify-content-center">
        <div class="col-md-6 col-lg-5">
            <div class="card shadow-sm border-0 rounded-3">
                <div class="card-header bg-primary text-white py-3 rounded-top-3">
                    <h4 class="mb-0 fw-bold">
                        <i class="fa-solid fa-folder-plus me-2"></i>Add New Genre
                    </h4>
                </div>

                <div class="card-body p-4">
                    @if (TempData["Error"] != null)
                    {
                        <div class="alert alert-danger alert-dismissible fade show shadow-sm mb-4" role="alert">
                            <i class="fa-solid fa-circle-exclamation me-2"></i>@TempData["Error"]
                            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                        </div>
                    }

                    <form asp-action="AddGenre" asp-controller="Genre" method="post">
                        <div class="mb-4">
                            <label class="form-label fw-bold text-dark">Genre Name</label>
                            <div class="input-group">
                                <span class="input-group-text bg-light"><i class="fa-solid fa-tag"></i></span>
                                <input asp-for="GenreName" class="form-control" placeholder="Enter genre name" />
                            </div>
                            <span asp-validation-for="GenreName" class="text-danger small mt-1 d-block"></span>
                        </div>

                        <div class="d-flex justify-content-end gap-2 pt-2 border-top">
                            <a href="/Genre/Index" class="btn btn-outline-secondary rounded-pill px-4">
                                <i class="fa-solid fa-xmark me-1"></i> Cancel
                            </a>
                            <button type="submit" class="btn btn-primary rounded-pill px-4 shadow-sm">
                                <i class="fa-solid fa-floppy-disk me-1"></i> Save
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>