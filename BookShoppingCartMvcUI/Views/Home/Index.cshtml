 @model BookDisplayModel

@{
    ViewData["Title"] = "Home Page";
}


<div class="my-4">

   <form asp-action="Index" asp-controller="Home" method="get" class="row row-cols-lg-auto g-3 align-items-center">
  

  <div class="col-12">
    <label  class="visually-hidden" for="inlineFormSelectPref">Genres</label>
            <select class="form-select" id="genreId" name="genreId">
      <option selected>Choose...</option>
                @foreach (var genre in Model.Genres)
                {
                    <option value="@genre.Id">@genre.GenreName</option>
                }
                
     
                
    </select>
  </div>
        <div class="col-12">
            <label class="visually-hidden" for="inlineFormInputGroupUsername">Search By Title</label>
            <div class="input-group">
                <div class="input-group-text"></div>
                <input type="text" class="form-control" id="sterm" name="sterm" placeholder="Search by title">
            </div>
        </div>

 

  <div class="col-12">
    <button type="submit" class="btn btn-primary">Search</button>
     <button asp-action="Index" asp-controller="Home" class="btn btn-primary">Reset</button>
  </div>
</form>
 </div>

<div class="w-100 d-flex flex-wrap justify-content-center">
   @foreach (var book in Model.Books)
{
    <div class="card mt-4 mx-2 mb-4 border-0 shadow-sm custom-book-card" style="width: 16rem; transition: transform 0.2s ease, shadow 0.2s ease;">

        @if (string.IsNullOrEmpty(book.Image))
        {
            <img style="width: 100%; height: 280px; object-fit: cover;" src="~/images/noimage.png" class="card-img-top rounded-top" alt="@book.BookName" />
        }
        else
        {
            <img style="width: 100%; height: 280px; object-fit: cover;" src="~/Images/@book.Image" class="card-img-top rounded-top" alt="@book.BookName" />
        }
      
        <div class="card-body d-flex flex-column justify-content-between p-3">
            <div>
                <h5 class="card-title fw-bold text-dark text-truncate" title="@book.BookName">@book.BookName</h5>
                <p class="card-text text-muted small mb-2">
                    <span class="d-block mb-1"><i class="fa-solid fa-tags me-1 text-primary"></i> <strong>Genre:</strong> @book.GenreName</span>
                    <span class="d-block mb-1"><i class="fa-solid fa-user-pen me-1 text-secondary"></i> <strong>Author:</strong> @book.AuthorName</span>
                    <span class="d-block fw-bold text-success fs-6 mt-2"><i class="fa-solid fa-money-bill-wave me-1"></i> @book.Price.ToString("C0") EGP</span>
                </p>
            </div>

            <div class="mt-2">
                @if (book.Quantity > 0)
                {
                    <button type="button" onclick="add(@book.Id)" class="btn btn-primary w-100 fw-semibold rounded-pill">
                        <i class="fa-solid fa-cart-plus me-1"></i> Add to cart
                    </button>
                }
                else
                {
                    <span class="btn btn-outline-danger disabled w-100 rounded-pill">
                        <i class="fa-solid fa-ban me-1"></i> Out of stock
                    </span>
                }
            </div>
        </div>
    </div>
}

</div>
</div>
@section Scripts {
    <script>
        async function add(bookId) {
            var usernameEl = document.getElementById("userName");
            if (usernameEl == null) {
                window.location.href = "/Identity/Account/Login";
                return;
            }

            try {
                var response = await fetch(`/Cart/AddItem?bookId=${bookId}`);
                if (response.status == 200) {
                    var result = await response.json();
                    var cartCountEl = document.getElementById("cartCount");
                    if (cartCountEl) {
                        cartCountEl.innerHTML = result;
                    }
                    
                    showSuccessToast("Book added to cart successfully!");
                } else {
                    alert("An error occurred while adding the item.");
                }
            }
            catch (err) {
                console.log(err);
            }
        }

        function showSuccessToast(message) {
            var toastHtml = `
                <div class="toast align-items-center text-bg-success border-0 position-fixed bottom-0 end-0 m-3 show" role="alert" aria-live="assertive" aria-atomic="true" style="z-index: 9999;">
                    <div class="d-flex">
                        <div class="toast-body fs-6">
                            <i class="fa-solid fa-circle-check me-2"></i> ${message}
                        </div>
                        <button type="button" class="btn-close btn-close-white me-2 m-auto" data-bs-dismiss="toast" aria-label="Close"></button>
                    </div>
                </div>
            `;
            
            var div = document.createElement('div');
            div.innerHTML = toastHtml;
            document.body.appendChild(div);

            setTimeout(() => {
                div.remove();
            }, 3000);
        }
    </script>
}  