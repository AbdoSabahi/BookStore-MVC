@{
    ViewData["Title"] = "Privacy Policy";
}
<div class="container my-5">
    <h1 class="mb-4 text-primary"><i class="fa-solid fa-user-shield me-2"></i>Privacy Policy</h1>
    <p class="lead text-muted">At EBookStore, we take your personal privacy very seriously.</p>

    <hr class="my-4" />

    <div class="row g-4">
        <div class="col-md-6">
            <div class="card h-100 shadow-sm border-0 bg-light p-3">
                <h5 class="fw-bold"><i class="fa-solid fa-database text-primary me-2"></i>Data We Collect</h5>
                <p class="text-secondary m-0">We only collect essential information required to fulfill your book orders, such as your name, email address, and shipping information.</p>
            </div>
        </div>
        <div class="col-md-6">
            <div class="card h-100 shadow-sm border-0 bg-light p-3">
                <h5 class="fw-bold"><i class="fa-solid fa-lock text-success me-2"></i>Data Protection</h5>
                <p class="text-secondary m-0">Your password and account details are securely encrypted. We do not share or sell your personal information to third parties.</p>
            </div>
        </div>
    </div>
</div>