@model Book


@{
    ViewData["Title"] = "Add Book";
}

<div class="container py-4">
    <div class="row justify-content-center">
        <div class="col-md-8 col-lg-6">
            <div class="card shadow-sm border-0 rounded-3">
                <div class="card-header bg-primary text-white py-3 rounded-top-3">
                    <h4 class="mb-0 fw-bold">
                        <i class="fa-solid fa-book-medical me-2"></i>Add New Book
                    </h4>
                </div>

                <div class="card-body p-4">
                    @if (TempData["Error"] != null)
                    {
                        <div class="alert alert-danger alert-dismissible fade show mb-4" role="alert">
                            <i class="fa-solid fa-triangle-exclamation me-2"></i>@TempData["Error"]
                            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                        </div>
                    }

                    <form asp-action="AddBook" asp-controller="Book" method="post" enctype="multipart/form-data">
                        
                        <div class="mb-3">
                            <label class="form-label fw-bold text-dark">Book Name</label>
                            <div class="input-group">
                                <span class="input-group-text bg-light"><i class="fa-solid fa-book"></i></span>
                                <input asp-for="BookName" class="form-control" placeholder="Enter book title" />
                            </div>
                            <span asp-validation-for="BookName" class="text-danger small"></span>
                        </div>

                        <div class="mb-3">
                            <label class="form-label fw-bold text-dark">Author Name</label>
                            <div class="input-group">
                                <span class="input-group-text bg-light"><i class="fa-solid fa-user-pen"></i></span>
                                <input asp-for="AuthorName" class="form-control" placeholder="Enter author name" />
                            </div>
                            <span asp-validation-for="AuthorName" class="text-danger small"></span>
                        </div>

                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label class="form-label fw-bold text-dark">Price ($)</label>
                                <div class="input-group">
                                    <span class="input-group-text bg-light"><i class="fa-solid fa-tag"></i></span>
                                    <input asp-for="Price" class="form-control" type="number" step="0.01" placeholder="0.00" />
                                </div>
                                <span asp-validation-for="Price" class="text-danger small"></span>
                            </div>

                            <div class="col-md-6 mb-3">
                                <label class="form-label fw-bold text-dark">Quantity (Stock)</label>
                                <div class="input-group">
                                    <span class="input-group-text bg-light"><i class="fa-solid fa-boxes-stacked"></i></span>
                                    <input asp-for="Quantity" class="form-control" type="number" placeholder="Available stock" />
                                </div>
                                <span asp-validation-for="Quantity" class="text-danger small"></span>
                            </div>
                        </div>

                        <div class="mb-3">
                            <label class="form-label fw-bold text-dark">Genre</label>
                            <div class="input-group">
                                <span class="input-group-text bg-light"><i class="fa-solid fa-list-check"></i></span>
                                <select asp-for="GenreId" asp-items="ViewBag.Genres" class="form-select">
                                    <option value="">-- Select Genre --</option>
                                </select>
                            </div>
                            <span asp-validation-for="GenreId" class="text-danger small"></span>
                        </div>

                        <div class="mb-4">
                            <label class="form-label fw-bold text-dark">Book Image</label>
                            <input type="file" name="imageFile" class="form-control" accept="image/*" />
                        </div>

                        <div class="d-flex justify-content-end gap-2 pt-2 border-top">
                            <a href="/Book/Index" class="btn btn-outline-secondary rounded-pill px-4">
                                <i class="fa-solid fa-xmark me-1"></i> Cancel
                            </a>
                            <button type="submit" class="btn btn-primary rounded-pill px-4 shadow-sm">
                                <i class="fa-solid fa-floppy-disk me-1"></i> Save Book
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>