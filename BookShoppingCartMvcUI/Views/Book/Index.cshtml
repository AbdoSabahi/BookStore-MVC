@model IEnumerable<Book>
@{
    ViewData["Title"] = "Manage Books";
}

<div class="container py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h3 class="fw-bold text-dark mb-1">
                <i class="fa-solid fa-book-bookmark me-2 text-primary"></i>Manage Books
            </h3>
            <p class="text-muted small mb-0">View, update, or remove books from your store inventory.</p>
        </div>
        <a class="btn btn-primary rounded-pill px-4 shadow-sm" href="/Book/AddBook">
            <i class="fa-solid fa-plus me-1"></i> Add New Book
        </a>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show shadow-sm mb-4" role="alert">
            <i class="fa-solid fa-circle-check me-2"></i>@TempData["Success"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <div class="card border-0 shadow-sm rounded-3 overflow-hidden">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-dark">
                        <tr>
                            <th class="ps-3" style="width: 90px;">Image</th>
                            <th>Book Name</th>
                            <th>Author</th>
                            <th>Genre</th>
                            <th>Price</th>
                            <th>Stock</th>
                            <th class="text-center" style="width: 160px;">Action</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var book in Model)
                        {
                            <tr>
                                <td class="ps-3">
                                    <img src="/images/@(string.IsNullOrEmpty(book.Image) ? "NoImage.png" : book.Image)" 
                                         class="rounded shadow-sm border" 
                                         style="width: 50px; height: 70px; object-fit: cover;" />
                                </td>
                                <td class="fw-semibold text-dark">@book.BookName</td>
                                <td class="text-secondary">@book.AuthorName</td>
                                <td>
                                    <span class="badge bg-light text-dark border">
                                        @(book.Genre?.GenreName ?? "N/A")
                                    </span>
                                </td>
                                <td class="fw-bold text-success">$@book.Price</td>
                                <td>
                                    @if ((book.Stock?.Quantity ?? 0) > 0)
                                    {
                                        <span class="badge bg-success-subtle text-success border border-success-subtle">
                                            @(book.Stock?.Quantity) in stock
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-danger-subtle text-danger border border-danger-subtle">
                                            Out of stock
                                        </span>
                                    }
                                </td>
                                <td class="text-center">
                                    <div class="btn-group gap-1" role="group">
                                        <a class="btn btn-outline-primary btn-sm rounded" href="/Book/EditBook?id=@book.Id">
                                            <i class="fa-solid fa-pen"></i> Edit
                                        </a>
                                        <button type="button" class="btn btn-outline-danger btn-sm rounded" onclick="confirmDelete(@book.Id)">
                                            <i class="fa-solid fa-trash"></i> Delete
                                        </button>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        function confirmDelete(bookId) {
            Swal.fire({
                title: 'Are you sure?',
                text: "This action will permanently delete the book!",
                icon: 'warning',
                showCancelButton: true,
                confirmButtonColor: '#dc3545',
                cancelButtonColor: '#6c757d',
                confirmButtonText: 'Yes, delete it!',
                cancelButtonText: 'Cancel',
                customClass: {
                    popup: 'rounded-4'
                }
            }).then((result) => {
                if (result.isConfirmed) {
                    window.location.href = `/Book/DeleteBook?id=${bookId}`;
                }
            });
        }
    </script>
}