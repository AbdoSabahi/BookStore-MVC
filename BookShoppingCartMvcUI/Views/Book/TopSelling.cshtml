@model IEnumerable<Book>
@{
    ViewData["Title"] = "Top 5 Selling Books";
}

<div class="container py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h3 class="fw-bold text-dark mb-1">
                <i class="fa-solid fa-trophy text-warning me-2"></i>Top 5 Selling Books
            </h3>
            <p class="text-muted small mb-0">Highest-performing books based on overall customer purchases.</p>
        </div>
        <a class="btn btn-outline-secondary rounded-pill px-3" href="/Admin/Index">
            <i class="fa-solid fa-arrow-left me-1"></i> Back to Dashboard
        </a>
    </div>

    @if (Model != null && Model.Any())
    {
        <div class="card border-0 shadow-sm rounded-3 overflow-hidden">
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="table-dark">
                            <tr>
                                <th class="text-center" style="width: 90px;">Rank</th>
                                <th style="width: 90px;">Image</th>
                                <th>Book Name</th>
                                <th>Author</th>
                                <th>Genre</th>
                                <th>Price</th>
                            </tr>
                        </thead>
                        <tbody>
                            @{
                                int rank = 1;
                            }
                            @foreach (var book in Model)
                            {
                                <tr>
                                    <td class="text-center">
                                        @if (rank == 1)
                                        {
                                            <span class="badge bg-warning text-dark fs-6 rounded-pill px-3 shadow-sm">
                                                <i class="fa-solid fa-crown me-1"></i>#1
                                            </span>
                                        }
                                        else if (rank == 2)
                                        {
                                            <span class="badge bg-secondary text-white fs-6 rounded-pill px-3 shadow-sm">
                                                #2
                                            </span>
                                        }
                                        else if (rank == 3)
                                        {
                                            <span class="badge bg-danger bg-opacity-75 text-white fs-6 rounded-pill px-3 shadow-sm" style="background-color: #cd7f32 !important;">
                                                #3
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="fw-bold text-muted fs-6">
                                                #@rank
                                            </span>
                                        }
                                    </td>
                                    <td>
                                        <img src="/images/@(string.IsNullOrEmpty(book.Image) ? "NoImage.png" : book.Image)" 
                                             class="rounded shadow-sm border" 
                                             style="width: 50px; height: 70px; object-fit: cover;" />
                                    </td>
                                    <td class="fw-semibold text-dark">@book.BookName</td>
                                    <td class="text-secondary">@book.AuthorName</td>
                                    <td>
                                        <span class="badge bg-light text-dark border">
                                            @(book.Genre?.GenreName ?? "N/A")
                                        </span>
                                    </td>
                                    <td class="fw-bold text-success">$@book.Price</td>
                                </tr>
                                rank++;
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    }
    else
    {
        <!-- واجهة عدم وجود مبيعات -->
        <div class="text-center py-5 my-4 bg-light rounded-4 border border-1">
            <div class="mb-3 text-muted opacity-50">
                <i class="fa-solid fa-chart-line fa-5x"></i>
            </div>
            <h4 class="fw-bold text-dark mb-2">No Sales Data Available Yet</h4>
            <p class="text-muted mb-0">Sales statistics will appear here once customers start placing orders.</p>
        </div>
    }
</div>