@model IEnumerable<Order>
@{
    ViewData["Title"] = "My Orders";
}

<div class="container py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h3 class="fw-bold text-dark mb-1">
                <i class="fa-solid fa-bag-shopping text-primary me-2"></i>My Orders
            </h3>
            <p class="text-muted small mb-0">View your order history and track purchased items.</p>
        </div>
        <a href="/Identity/Account/Manage" class="btn btn-outline-secondary rounded-pill px-3 shadow-sm">
            <i class="fa-solid fa-arrow-left me-1"></i> Back to Account
        </a>
    </div>

    @if (Model != null && Model.Any())
    {
        <div class="vstack gap-4">
            @foreach (var order in Model)
            {
                <div class="card border-0 shadow-sm rounded-3 overflow-hidden">
                    <div class="card-header bg-light d-flex justify-content-between align-items-center py-3 px-4 border-bottom">
                        <div>
                            <span class="text-muted small d-block">Order Date</span>
                            <span class="fw-bold text-dark">
                                <i class="fa-regular fa-calendar me-1 text-primary"></i>
                                @order.CreateDate.ToString("dd-MM-yyyy")
                            </span>
                        </div>
                        <div>
                            <span class="text-muted small d-block">Status</span>
                            <span class="badge bg-info-subtle text-info-emphasis border border-info-subtle px-3 py-1 rounded-pill">
                                @order.OrderStatus?.StatusName
                            </span>
                        </div>
                    </div>

                    <div class="card-body p-0">
                        @if (order.OrderDetail != null && order.OrderDetail.Any())
                        {
                            <div class="table-responsive">
                                <table class="table table-hover align-middle mb-0">
                                    <thead class="table-light text-secondary small">
                                        <tr>
                                            <th class="ps-4" style="width: 80px;">Image</th>
                                            <th>Book Name</th>
                                            <th>Genre</th>
                                            <th>Unit Price</th>
                                            <th class="text-end pe-4">Total Price</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var item in order.OrderDetail)
                                        {
                                            <tr>
                                                <td class="ps-4 py-3">
                                                    <img src="/images/@(string.IsNullOrEmpty(item.Book.Image) ? "NoImage.png" : item.Book.Image)" 
                                                         class="rounded shadow-sm border" 
                                                         style="width: 50px; height: 65px; object-fit: cover;" />
                                                </td>
                                                <td class="fw-semibold text-dark">@item.Book.BookName</td>
                                                <td>
                                                    <span class="badge bg-light text-dark border">
                                                        @(item.Book.Genre?.GenreName ?? "N/A")
                                                    </span>
                                                </td>
                                                <td class="text-secondary">
                                                    $@item.Book.Price <span class="text-muted small">× @item.Quantity</span>
                                                </td>
                                                <td class="text-end pe-4 fw-bold text-success">
                                                    $@(item.Book.Price * item.Quantity)
                                                </td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>

                            <div class="card-footer bg-white d-flex justify-content-between align-items-center py-3 px-4 border-top">
                                <span class="fw-bold text-secondary">Total Amount:</span>
                                <span class="fw-bold fs-5 text-success">
                                    $@(order.OrderDetail.Select(item => item.Book.Price * item.Quantity).Sum())
                                </span>
                            </div>
                        }
                    </div>
                </div>
            }
        </div>
    }
    else
    {
        <div class="text-center py-5 my-4 bg-light rounded-4 border border-1">
            <div class="mb-4 text-muted opacity-50">
                <i class="fa-solid fa-box-open fa-6x"></i>
            </div>

            <h3 class="fw-bold text-dark mb-2">No Orders Found</h3>
            <p class="text-muted mb-4 fs-6">You haven't placed any orders yet. Start exploring our book collection!</p>

            <a href="/Home/Index" class="btn btn-primary btn-lg rounded-pill px-4 shadow-sm">
                <i class="fa-solid fa-store me-2"></i> Browse Books
            </a>
        </div>
    }
</div>